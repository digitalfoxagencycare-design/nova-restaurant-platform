# Copy to .env.local (never commit). All values are build-time.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Fixed restaurant code for a per-restaurant build (Android, or a website on its own domain). Leave empty for /s/<code> URLs.
VITE_TENANT=
# Android app display name (used by capacitor.config.json via CAP_APP_NAME)
VITE_APP_NAME=
