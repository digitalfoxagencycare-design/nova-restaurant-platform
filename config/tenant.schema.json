{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nova tenant configuration",
  "type": "object",
  "required": ["slug", "brand", "locale", "tax", "operations"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
    "brand": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "legal_name": { "type": "string" },
        "tagline": { "type": "string" },
        "logo_url": { "type": "string" },
        "colors": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
        "fonts": { "type": "object", "properties": { "heading": { "type": "string" }, "body": { "type": "string" } } },
        "support": { "type": "object", "properties": { "phone": { "type": "string" }, "email": { "type": "string" } } }
      }
    },
    "locale": {
      "type": "object",
      "required": ["currency", "timezone", "country_code"],
      "properties": {
        "currency": { "type": "string", "default": "INR" },
        "timezone": { "type": "string", "default": "Asia/Kolkata" },
        "country_code": { "type": "string", "default": "91" },
        "phone_regex": { "type": "string", "default": "^[6-9]\\d{9}$" },
        "languages": { "type": "array", "items": { "type": "string" }, "default": ["en"] }
      }
    },
    "tax": {
      "type": "object",
      "required": ["mode", "default_rate"],
      "properties": {
        "mode": { "enum": ["inclusive", "exclusive"] },
        "default_rate": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "gstin": { "type": "string" }
      }
    },
    "operations": {
      "type": "object",
      "required": ["business_day_start"],
      "properties": {
        "business_day_start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "order_number_format": { "type": "string", "default": "{YYMMDD}-{seq:04}" },
        "stations": { "type": "array", "items": { "type": "string" }, "default": ["kitchen"] },
        "flows": {
          "type": "object",
          "description": "Allowed status sequence per order type",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "ordering": {
      "type": "object",
      "properties": {
        "channels": { "type": "array", "items": { "enum": ["dine-in", "takeaway", "delivery"] } },
        "dine_in": { "type": "object", "properties": { "require_prepaid_for_self_order": { "type": "boolean" } } },
        "min_order": { "type": "number" }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "max_km": { "type": "number" },
        "free_above": { "type": "number" },
        "fee_slabs": {
          "type": "array",
          "items": { "type": "object", "required": ["up_to_km", "fee"], "properties": { "up_to_km": { "type": "number" }, "fee": { "type": "number" } } }
        }
      }
    },
    "payments": {
      "type": "object",
      "properties": {
        "methods": { "type": "array", "items": { "enum": ["cash", "card", "upi", "cod", "razorpay"] } },
        "cod": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "disabled_windows": { "type": "array", "items": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" } } } }
          }
        }
      }
    },
    "loyalty": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "earn_per_rupees": { "type": "number" },
        "coin_value": { "type": "number" },
        "welcome_bonus": { "type": "integer" },
        "first_orders": { "type": "object", "properties": { "count": { "type": "integer" }, "discount": { "type": "number" }, "min_subtotal": { "type": "number" } } },
        "min_redeem": { "type": "integer" },
        "max_order_share": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "integrations": {
      "type": "object",
      "description": "References only. Secrets live in the secret manager, never here.",
      "properties": {
        "whatsapp": { "type": "object", "properties": { "project": { "type": "string" }, "otp_template": { "type": "string" } } },
        "razorpay": { "type": "object", "properties": { "secret_ref": { "type": "string" } } },
        "fcm": { "type": "object", "properties": { "topic": { "type": "string" } } }
      }
    }
  }
}
