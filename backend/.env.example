# Copy to .env for local development. NEVER commit real values.
ENV=development                 # development | test | production
MONGO_URL=mongodb://localhost:27017
DB_NAME=nova_platform
# JWT keys: JSON object kid -> secret (>= 32 random chars each). Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_KEYS={"k1":"REPLACE_WITH_RANDOM_48_CHARS_MINIMUM_xxxxxxxxxxxxxxxxxxxx"}
JWT_ACTIVE_KID=k1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Debug switches: must stay false/unset in production (startup refuses otherwise)
DEBUG_OTP=false
ALLOW_TEST_OTP=false
